# Plantilla de variables de CoreFlow Backend. Copiar a .env para desarrollo local.
# En Render, cargar estas variables en Environment (nunca subir .env a GitHub).
# [SECRETO] = valor privado: completarlo sólo en .env local o en el panel de Render.

# --- Entorno y servidor ---------------------------------------------------------
# development | test | production. En Render: production.
NODE_ENV=development
# Local: 127.0.0.1. En Render: 0.0.0.0 (si se omite, se usa 0.0.0.0 cuando RENDER=true).
HOST=127.0.0.1
# Local: 3000. En Render no definirla: la plataforma asigna PORT automáticamente.
PORT=3000

# --- Frontend, CORS y cookies ------------------------------------------------------
# Origen público del frontend, sin rutas (se tolera la barra final). HTTPS en producción.
# Ejemplo producción: PUBLIC_APP_URL=https://timely-beignet-719e37.netlify.app
PUBLIC_APP_URL=http://localhost:5173
# Orígenes permitidos separados por comas. En producción deben ser HTTPS e incluir
# PUBLIC_APP_URL. Ejemplo: CORS_ORIGINS=https://timely-beignet-719e37.netlify.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# lax (por defecto): frontend y API en el mismo sitio (dominio propio o rewrite /api).
# none: frontend en otro dominio que llama directo a la API (p. ej. *.netlify.app →
# *.onrender.com). Requiere NODE_ENV=production; emite Secure + Partitioned.
AUTH_COOKIE_SAME_SITE=lax
# IP/subredes de proxies confiables o loopback | linklocal | uniquelocal.
# Vacío: conexión directa. Nunca true ni un número de saltos.
TRUST_PROXY=

# --- Autenticación ---------------------------------------------------------------
# [SECRETO] Clave aleatoria de al menos 32 bytes. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración de la sesión en segundos (300 a 86400).
AUTH_SESSION_SECONDS=28800

# --- Base de datos (TiDB Cloud) --------------------------------------------------
DB_HOST=gateway01.sa-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
# [SECRETO] Usuario de TiDB Cloud (formato <prefijo>.root o similar).
DB_USER=your_tidb_user
# [SECRETO] Contraseña de TiDB Cloud.
DB_PASSWORD=
DB_NAME=coreflow
# TiDB Cloud exige TLS con verificación de CA y nombre del servidor.
DB_SSL=true
# CA público ISRG Root X1, versionado en el repositorio. Ruta relativa a la raíz del
# backend o absoluta (p. ej. /etc/secrets/isrgrootx1.pem si se usa un Secret File).
DB_SSL_CA=certs/isrgrootx1.pem
# Alternativa local sin TiDB: DB_HOST=127.0.0.1, DB_PORT=3307, usuario/contraseña
# locales, DB_SSL=false y DB_SSL_CA vacía. DB_NAME sigue siendo coreflow.

# --- Correo (opcional) -----------------------------------------------------------
# Sin SMTP_HOST/MAIL_FROM no se envían correos; se registra el fallo recuperable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# [SECRETO] SMTP_USER y SMTP_PASSWORD se configuran juntos.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
