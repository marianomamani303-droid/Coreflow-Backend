DB_HOST=gateway01.sa-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
# Copiar el usuario de TiDB Cloud; no incluir la contraseña en este ejemplo.
DB_USER=your_tidb_user
DB_PASSWORD=
DB_NAME=coreflow

HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=
NODE_ENV=development
AUTH_SESSION_SECONDS=28800
# lax (por defecto): frontend y API en el mismo sitio (dominio propio o rewrite /api).
# none: frontend en otro dominio que llama directo a la API; requiere NODE_ENV=production.
AUTH_COOKIE_SAME_SITE=lax
# IP/subredes de tu proxy, separadas por comas. Vacío: conexión directa.
# Para Nginx en el mismo servidor: TRUST_PROXY=loopback
TRUST_PROXY=
# TiDB Cloud exige TLS con verificación de CA y nombre del servidor.
DB_SSL=true
# Ruta absoluta o relativa al backend. Provisionar el PEM en el hosting.
DB_SSL_CA=certs/isrgrootx1.pem
# Alternativa local: DB_HOST=127.0.0.1, DB_PORT=3307, usuario/contraseña
# locales, DB_SSL=false y DB_SSL_CA vacía. DB_NAME sigue siendo coreflow.

# Origen publico del frontend, sin rutas. HTTPS en produccion.
PUBLIC_APP_URL=http://localhost:5173
# Sin SMTP_HOST/MAIL_FROM no se envian correos; se registra el fallo recuperable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
